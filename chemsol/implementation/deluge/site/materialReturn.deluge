// ============================================================
// Material Return — credit allocation + restore stock (A-40, C12)
// Verified: flow_sim.py P5 (consumed 265/114.5, returned 10/10, stock 10/285)
// ============================================================
// Workflow: On Submit (Material_Return_Entry).
// C12: BOTH Consumed_Qty - AND Returned_Qty + (Remaining formula needs both).
// Good/Unused -> stock restored; Damaged/Expired -> damaged count only.

for each item in input.Line_Items
{
  alloc = lookupRecords(MR_Allocation, {"Project_ID": input.Project_ID, "Item_Code": item.RM_Item_Code});
  if(isNull(alloc))
  {
    throw "No matching MR Allocation for " + item.RM_Item_Code;
  }
  a = alloc.get(0);

  if(item.Return_Qty > a.Consumed_Qty)
  {
    throw "Return (" + item.Return_Qty + ") cannot exceed consumed (" + a.Consumed_Qty + ") for " + item.RM_Item_Code;
  }

  newConsumed = a.Consumed_Qty - item.Return_Qty;
  updateRecord
  {
    "Form_Type": "MR_Allocation",
    "ID": a.ID,
    "Consumed_Qty": newConsumed,
    "Returned_Qty": a.Returned_Qty + item.Return_Qty,
    "Consumption_Percentage": (newConsumed / a.Assigned_Qty) * 100
  };

  if(item.Condition == "Good" || item.Condition == "Unused")
  {
    stockMoveRM({"store": input.Warehouse, "item_code": item.RM_Item_Code,
      "item_name": item.RM_Item_Name, "qty": item.Return_Qty, "doc_type": "MATERIAL_RETURN",
      "doc_ref": input.Return_No, "uom": item.UOM, "project_id": input.Project_ID});
  }
  // Damaged/Expired: damaged count tracked on the MRT line, no stock credit
}
