// ============================================================
// P5 — SO<->BOM<->MR cross-validation (A-16, C31)
// Verified: flow_sim.py P3 (0% pass; +6% flag; +11% block)
// ============================================================
// Workflow: On Submit (MR_Master) — validate BEFORE create.
// Per-RM rule (C31): diff% = |Assigned - BOM expected| / expected x 100
// any line >5% -> Variance_Flag + warning; any line >10% -> block (throw).

// expected kg per RM from SO System Lines x Composition x BOM
so = lookupRecords(SO_Master, {"Project_ID": input.Project_ID}).get(0);
expectedByRM = Map();
for each sysLine in so.System_Lines
{
  comps = lookupRecords(System_Composition, {"System_Code": sysLine.System_Code});
  for each comp in comps
  {
    boms = lookupRecords(BOM, {"FG_Code": comp.FG_Code, "Status": "Released"});
    for each bom in boms
    {
      qty = sysLine.Area * comp.Qty_Per_Sqm * bom.Ratio;
      expectedByRM.put(bom.RM_Code, expectedByRM.get(bom.RM_Code, 0) + qty);
    }
  }
}

maxDiff = 0;
for each a in input.Material_Allocation
{
  exp = expectedByRM.get(a.Item_Code);
  if(exp == null || exp <= 0) { continue; }
  diff = abs(a.Assigned_Qty - exp) / exp * 100;
  if(diff > maxDiff) { maxDiff = diff; }
  if(diff > 10)
  {
    throw "Cross-validation BLOCKED: " + a.Item_Code + " assigned " + round(a.Assigned_Qty, 1)
      + " kg vs expected " + round(exp, 1) + " kg (diff " + round(diff, 1) + "% > 10%). Correct MR allocation first.";
  }
  if(diff > 5)
  {
    input.Variance_Flag = true;
  }
}
input.Variance_Percentage = maxDiff;
