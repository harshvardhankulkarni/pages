// ============================================================
// P5 — SO<->BOM<->MR cross-validation (A-16)
// Verified: flow_sim.py P3 (0% -> pass; +6% flag; +11% block)
// ============================================================
// Workflow: On Submit (MR_Master) — validate BEFORE create.
// diff% = |SUM(Assigned Qty) - SUM(SO Area x Comp x BOM)| / expected x 100
// >5% -> Variance_Flag + warning; >10% -> block submit (throw).

// expected from SO System Lines x Composition x BOM
so = lookupRecords(SO_Master, {"Project_ID": input.Project_ID}).get(0);
expected = 0;
for each sysLine in so.System_Lines
{
  comps = lookupRecords(System_Composition, {"System_Code": sysLine.System_Code});
  for each comp in comps
  {
    boms = lookupRecords(BOM, {"FG_Code": comp.FG_Code, "Status": "Released"});
    for each bom in boms
    {
      expected = expected + sysLine.Area * comp.Qty_Per_Sqm * bom.Ratio;
    }
  }
}

assigned = 0;
for each a in input.Material_Allocation
{
  assigned = assigned + a.Assigned_Qty;
}

diffPct = (abs(assigned - expected) / expected) * 100;

if(diffPct > 5)
{
  input.Variance_Percentage = diffPct;
  input.Variance_Flag = true;
  if(diffPct > 10)
  {
    throw "Cross-validation BLOCKED: assigned " + round(assigned, 1) + " kg vs expected "
      + round(expected, 1) + " kg (diff " + round(diffPct, 1) + "% > 10%). Correct MR allocation first.";
  }
  // >5% but <=10%: flag only
  input.Variance_Percentage = diffPct;
  input.Variance_Flag = true;
}
